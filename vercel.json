{
  "crons": [
    {
      "path": "/api/fantasy-live-scoring",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/fantasy-transactions",
      "schedule": "* * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "www.ballknowerofficial.com" }
      ],
      "destination": "https://ballknowerofficial.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
