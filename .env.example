VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only services. Never expose a Supabase service-role key to Vite.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Simulated-player production artwork. All values are server-only. The code and
# database both refuse to reserve more than $35 for the v4 production catalog.
SIMULATED_PLAYER_ART_ADMIN_KEY=USE_A_LONG_RANDOM_SERVER_ONLY_VALUE
SIMULATED_PLAYER_ART_GENERATION_ENABLED=false
SIMULATED_PLAYER_ART_BUDGET_USD=35
# Only needed by the local batch coordinator; omit from the browser bundle.
SIMULATED_PLAYER_ART_API_ORIGIN=https://ballknowerofficial.com

# Ask BK uses Vercel AI Gateway. Vercel deployments can authenticate through
# OIDC; use an API key for local/server environments that do not provide it.
AI_GATEWAY_API_KEY=YOUR_VERCEL_AI_GATEWAY_API_KEY
# Optional model overrides. Both defaults support text and screenshot input.
ASK_BK_MODEL=google/gemini-3.1-flash-lite
ASK_BK_FALLBACK_MODEL=openai/gpt-5.4-nano
# Emergency cost switch. Set false to disable live web search without disabling Ask BK.
ASK_BK_LIVE_SEARCH_ENABLED=true

# Sign in with Apple account-deletion revocation (server-only; never VITE_).
# APPLE_OAUTH_CLIENT_ID must match the client/service ID configured for Apple in Supabase.
APPLE_OAUTH_CLIENT_ID=YOUR_APPLE_OAUTH_CLIENT_ID
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_SIGN_IN_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"

# Tank01 / RapidAPI (server-only; never prefix these with VITE_)
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY
# TANK01_API_KEY can be used instead of RAPIDAPI_KEY.
TANK01_API_KEY=YOUR_RAPIDAPI_KEY
TANK01_RAPIDAPI_HOST=tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com
CRON_SECRET=USE_A_LONG_RANDOM_SERVER_ONLY_VALUE

# Optional automated beta bug-report delivery
RESEND_API_KEY=YOUR_RESEND_API_KEY
ERROR_REPORT_FROM_EMAIL=Ball Knower <errors@YOUR_VERIFIED_DOMAIN>
