{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:integrity": "node --import tsx scripts/integrity-check.ts",
    "check:draft-reliability": "node --import tsx scripts/draft-reliability-check.ts",
    "check:trivia": "node --import tsx scripts/gauntlet-trivia-check.ts",
    "check:identity": "node --import tsx scripts/account-identity-check.ts",
    "check:yahoo-parity": "node --import tsx scripts/yahoo-fantasy-parity-check.ts",
    "check:picks": "node --import tsx scripts/picks-correctness-check.ts",
    "check:phase1-correctness": "node --import tsx scripts/phase1-correctness-check.ts",
    "check:dst-rankings": "node --import tsx scripts/dst-rankings-check.ts",
    "check:fantasy-transactions": "node --import tsx scripts/fantasy-transaction-correctness-check.ts",
    "check:phase2-player-details": "node --import tsx scripts/phase2-player-detail-check.ts",
    "check:phase2-history": "node --import tsx scripts/phase2-history-snapshot-check.ts",
    "check:phase2-lineups": "node --import tsx scripts/phase2-deterministic-lineup-check.ts",
    "check:matchup-head-to-head": "node --import tsx scripts/matchup-head-to-head-check.ts",
    "check:phase3-agent": "node --import tsx scripts/phase3-agent-recruiting-check.ts",
    "check:phase3-careers": "node --import tsx scripts/phase3-agent-career-check.ts",
    "check:phase3-growth": "node --import tsx scripts/phase3-agent-growth-check.ts",
    "check:phase4-owner": "node --import tsx scripts/phase4-owner-postseason-check.ts",
    "check:final-release": "node --import tsx scripts/final-release-hardening-check.ts",
    "check:hardening": "npm run lint && npm run check:integrity && npm run check:draft-reliability && npm run check:trivia && npm run check:identity && npm run check:yahoo-parity && npm run check:picks && npm run check:phase1-correctness && npm run check:dst-rankings && npm run check:fantasy-transactions && npm run check:phase2-player-details && npm run check:phase2-history && npm run check:phase2-lineups && npm run check:matchup-head-to-head && npm run check:phase3-agent && npm run check:phase3-careers && npm run check:phase3-growth && npm run check:phase4-owner && npm run check:final-release"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
